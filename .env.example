# Copia questo file in ".env" e compila i valori.

# Password unica di famiglia per entrare nel sito (obbligatoria)
FAMILY_PASSWORD=cambiami

# Stringa casuale lunga usata per firmare il cookie di accesso (consigliata)
SESSION_SECRET=metti-qui-una-stringa-casuale-lunga

# Chiave API di Google con "Google Drive API" abilitata (fortemente consigliata:
# rende lo streaming affidabile, permette di saltare avanti/indietro nel video
# e verifica che il link sia condiviso correttamente)
GOOGLE_API_KEY=

# Account di servizio Google (INDISPENSABILE online: evita i blocchi di Google
# "automated queries" e "Quota exceeded"). Percorso del file .json scaricato da
# Google Cloud. In locale: service-account.json nella cartella del progetto.
# Su Render: /etc/secrets/service-account.json (caricato come "Secret File").
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json

# --- Salvataggio dell'elenco dei video ---
# In locale l'elenco viene salvato in data/videos.json.
# Su Render (piano gratuito) il disco si azzera a ogni riavvio, quindi usa un
# GitHub Gist segreto: crea un token con permesso "gist" e un gist con un file
# videos.json contenente [] (vedi README).
GITHUB_TOKEN=
GIST_ID=

# Porta del server (in locale 3001; su Render viene impostata automaticamente)
PORT=3001
